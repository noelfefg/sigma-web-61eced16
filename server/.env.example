PORT=8080
ENV=development

# Postgres (Lovable Cloud)
PG_DSN=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sigma

# Supabase JWT
SUPABASE_URL=https://qlrdqnxsdpqiymcstycn.supabase.co
SUPABASE_JWKS_URL=https://qlrdqnxsdpqiymcstycn.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=__legacy_HS256_secret_if_needed__

# Realtime
REDIS_URL=redis://localhost:6379

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@sigma.app

# CORS — comma separated origins
ALLOWED_ORIGINS=http://localhost:5173,https://sigma-web.lovable.app
